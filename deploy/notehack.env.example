# NoteHack production environment
# Install at /etc/notehack/notehack.env, chmod 600, chown root:root
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
PUBLIC_ORIGIN=https://notehack.com

# PostgreSQL
DATABASE_URL=postgres://notehack:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:5432/notehack

# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS
# Generate 32 random bytes, base64: openssl rand -base64 32
# Losing this key makes encrypted attachments and backups unreadable.
NOTEHACK_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES

NOTEHACK_DATA_DIR=/var/lib/notehack
WEB_DIST=/opt/notehack/apps/web/dist
NOTEHACK_ENV_FILE=/etc/notehack/notehack.env

# open | invite
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=

# Optional
OCR_ENABLED=true
MAX_UPLOAD_BYTES=26214400
BACKUP_RETENTION_DAYS=30
SESSION_DAYS=30
TRUST_PROXY=true

# AI is off by default. Prefer configuring it in the admin UI so keys are encrypted in DB.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
